{
  "name": "fake-artist",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build:shared": "npm run build -w shared",
    "build:api": "npm run build:shared && npm run build -w api",
    "build:web": "npm run build:shared && npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
